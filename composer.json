{
    "name": "suisen/suisen",
    "description": "北九州高専 生産デザイン工学科のコース選択を手助けするチャットアプリ",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Suisen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suisen\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
